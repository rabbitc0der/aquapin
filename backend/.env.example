# ==============================================================================
# AquaPin Backend Environment Variables Template (.env.example)
# ==============================================================================

PORT=3001
NODE_ENV=development
ALLOWED_ORIGIN=*

AWS_REGION=ap-south-1
TABLE_NAME=aquapin-pins

# AWS Credentials (optional for local fallback; use IAM roles in Lambda)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Enable AWS Rekognition in production
ENABLE_AWS_REKOGNITION=false
