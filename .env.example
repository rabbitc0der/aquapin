# ==============================================================================
# AquaPin Environment Variables Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Settings (Vite prefix: VITE_)
# ------------------------------------------------------------------------------
# Backend API Base URL (HTTP API Gateway or local dev server)
VITE_API_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Backend & Cloud Infrastructure Settings
# ------------------------------------------------------------------------------
# Server port for local development
PORT=3001

# Node environment ('development' | 'production')
NODE_ENV=development

# Allowed CORS Origin in production (e.g., https://aquapin.example.com)
# Defaults to '*' if empty in dev mode
ALLOWED_ORIGIN=*

# AWS Deployment Region
AWS_REGION=ap-south-1

# Amazon DynamoDB Table Name
TABLE_NAME=aquapin-pins

# DynamoDB Local Endpoint (leave empty for real AWS DynamoDB)
# DYNAMODB_ENDPOINT=http://localhost:8000

# AWS Credentials (when running outside AWS Lambda IAM execution role)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Enable AWS Rekognition for production AI image analysis (requires valid AWS creds)
ENABLE_AWS_REKOGNITION=false
